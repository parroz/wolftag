# WolfTag — Docker Compose environment
# Copy this to .env and edit before deploying.
# The frontend is served by the host nginx, not a container.

# Port the backend container binds to on localhost (host nginx proxies to this)
BACKEND_PORT=3000

# Printer settings — initial defaults only.
# After the first run, use the Settings UI (⚙ icon) to change these.
# They are stored in the database and survive container restarts.
PRINT_MODE=brother-raster
PRINTER_IP=192.168.1.122
PRINTER_PORT=9100
PRINTER_MODEL=PT-P750W
LABEL_WIDTH_MM=12
